# FCS Environment Configuration

ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql://fcs_user:fcs_password@localhost:5432/fcs_new_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@fcs.com

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://yourdomain.com"]

# File Storage
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Redis
REDIS_URL=redis://redis:6379

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key-for-aes256-change-in-production
