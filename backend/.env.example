# Copy to .env and fill with real values
# NEVER commit the .env file

# Email (SendGrid or SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@example.com

# Database
DATABASE_URL=postgresql://fcsuser:password@localhost:5432/fcs_db

# JWT
SECRET_KEY=generate-a-random-256-bit-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=generate-a-32-byte-hex-key-here
RESUME_DECRYPTION_KEY=generate-a-fernet-key-here

# Environment
ENVIRONMENT=development
DEBUG=false
